# Copie este arquivo para ".env" (que já está no .gitignore) e preencha os valores
# reais antes de rodar "docker compose up". Nunca commite o ".env" de verdade.

# Senha do usuário "sa" do container SQL Server — mínimo 8 caracteres, com
# maiúscula, minúscula, número e símbolo (exigência do próprio SQL Server).
MSSQL_SA_PASSWORD=Troque_Esta_Senha_123!

# Chave de assinatura dos JWTs — gere uma string aleatória longa (32+ caracteres).
# Ex.: openssl rand -base64 32
JWT_SIGNING_KEY=Troque_Esta_Chave_Por_Uma_Aleatoria_De_32_Ou_Mais_Caracteres
